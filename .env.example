# Burn Box Stage 2
PORT=5000

# Optional remote cloud (S3-compatible / Supabase Storage S3 gateway)
# Without these, Cloud mode still works via storage/cloud-mirror/
BURNBOX_CLOUD_ENABLED=false
BURNBOX_S3_BUCKET=
BURNBOX_S3_ACCESS_KEY=
BURNBOX_S3_SECRET_KEY=
BURNBOX_S3_ENDPOINT=
BURNBOX_S3_REGION=auto
BURNBOX_CLOUD_PUBLIC_URL=
