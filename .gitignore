# SQLite database files — never commit; exposes demo data at rest
data.db
data.db-shm
data.db-wal
data.db-journal

# Runtime file storage — vault contents should never be committed
storage/quarantine/*
storage/safe/*
storage/cloud-mirror/*
!storage/quarantine/.gitkeep
!storage/safe/.gitkeep
!storage/cloud-mirror/.gitkeep

